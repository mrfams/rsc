{
  "expo": {
    "name": "EMU Bin Tracker",
    "slug": "rscemu",
    "version": "1.0.0",
    "scheme": "rsc",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mrfams.rsc"
    },
    "android": {
      "package": "com.mrfams.rsc",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/favicon.png",
      "shortName": "EMU Bins",
      "description": "Community map of recycling bins on the EMU campus.",
      "lang": "en",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/",
      "startUrl": "/",
      "themeColor": "#0E7C5A",
      "backgroundColor": "#F3F5F4"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow EMU Bin Tracker to find your location so you can report nearby bins."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EMU Bin Tracker to add a photo of the bin you found.",
          "cameraPermission": "Allow EMU Bin Tracker to take a photo of the bin you found.",
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0d2ec211-da63-4d5e-aa1a-55a481286310"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0d2ec211-da63-4d5e-aa1a-55a481286310",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
