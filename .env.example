# Copy to .env and fill in — never commit .env.

# Neon Postgres connection string (Project dashboard → Connection Details).
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Better Auth — random 32-byte secret and the canonical base URL of the server.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8081

# Where the native app should send API requests (dev server or deployed URL).
EXPO_PUBLIC_API_URL=http://localhost:8081

# Optional: storage for uploaded photos on Vercel (Blob store token).
# Without it, photos fall back to ./.data/uploads served through /api/photos.
# BLOB_READ_WRITE_TOKEN=

# Moderation: emails allowed to use the /admin panel (comma-separated).
ADMIN_EMAILS=you@emu.edu.tr
# Public contact links shown in the app (optional).
# EXPO_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-handle/
# EXPO_PUBLIC_WHATSAPP_URL=https://wa.me/905000000000
