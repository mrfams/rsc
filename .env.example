# Copy to .env and fill in — never commit .env.

# Neon Postgres connection string (Project dashboard → Connection Details).
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Better Auth — random 32-byte secret and the canonical base URL of the server.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8081

# Where the native app should send API requests (dev server or deployed URL).
EXPO_PUBLIC_API_URL=http://localhost:8081

# Optional: storage for uploaded photos.
#
# Cloudflare R2 (recommended) — R2 dashboard → Account → R2 API Tokens →
# "Object Read & Write". Set all four; R2_PUBLIC_URL is the public base URL
# of the bucket (custom domain or the r2.dev URL) and is what the app links to.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=rsc-photos
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Vercel Blob — alternative to R2 (Vercel dashboard → Storage → Blob).
# BLOB_READ_WRITE_TOKEN=

# With neither configured, photos are written to ./.data/uploads in local
# development only — a serverless deployment has a read-only filesystem and
# will refuse the upload with a clear message.

# Moderation: emails allowed to use the /admin panel (comma-separated).
ADMIN_EMAILS=you@emu.edu.tr
# Public contact links shown in the app (optional — these are the defaults).
# EXPO_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/rsemu_club/
# EXPO_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/HfmvqCAdJ629e6kG2k9x0T?s=cl&p=a&mlu=4&ilr=4

# Direct install link for the Android APK.
# The /download page and its QR code read this from the server first (the URL
# `npm run publish:apk` writes into app_config); this is the fallback baked
# into the bundle. It points at the newest GitHub release asset, so it never
# goes stale.
# EXPO_PUBLIC_ANDROID_DOWNLOAD_URL=https://github.com/mrfams/rsc/releases/latest/download/app.apk
