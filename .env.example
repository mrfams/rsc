# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres connection string (Project → Connection Details → Pooled URL).
DATABASE_URL=

# ─── Auth (Better Auth) ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public base URL of the deployed server (same host as the web app).
BETTER_AUTH_URL=http://localhost:8081

# ─── Expo client ────────────────────────────────────────────────────────────
# Base URL the native app uses to reach the API (web is always same-origin).
# Locally: the Expo dev server URL. In production: your Vercel domain.
EXPO_PUBLIC_API_URL=http://localhost:8081

# ─── Photo storage (optional) ───────────────────────────────────────────────
# Vercel Blob token. Without it, photos are stored under ./.data/uploads and
# served locally — the app still works, through the /api/photos proxy.
BLOB_READ_WRITE_TOKEN=
